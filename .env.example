# Copy to .env.local and fill in. Never commit real secrets (.env* is gitignored).
# In production, set these in the Vercel dashboard.
#
# These are the environment variables from PROJECT.md. The supporter logo strip
# (deferred) needs no additional variables.

# --- Required (from PROJECT.md) -------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (nomination approval + warm-intro)
RESEND_API_KEY=

# LinkedIn OIDC — "Sign in with LinkedIn" for speaker self-nomination.
# NOTE: these are entered in the Supabase dashboard (Authentication > Providers
# > LinkedIn OIDC), not read by the app. Listed here for deployment reference.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Optional (email tuning; sensible fallbacks if unset) ------------------

# Verified sender in Resend, e.g. "Women's Speaker Collective <hello@yourdomain.com>".
# Falls back to Resend's onboarding@resend.dev (test only) if unset.
RESEND_FROM=
# Collective operator address — warm-intro speaker-copy fallback + reply-to.
# Defaults to anjali@waterbridge.vc.
BUREAU_ADMIN_EMAIL=
# Name used to sign outbound emails (the "[Admin name]" in the template).
# Defaults to Anjali.
BUREAU_ADMIN_NAME=
